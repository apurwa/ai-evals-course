# Credentials for the local Langfuse stack.
#
# These match the LANGFUSE_INIT_* values in docker-compose.yml, and they are
# also the built-in defaults in agent/langfuse_sink.py. So on a laptop you do
# not need this file at all: `make trace-up` then `make trace-demo` works with
# no environment set up.
#
# It is here for the two cases where the defaults are wrong.
#
#   1. You want to point at Langfuse Cloud instead of the local stack.
#   2. You changed the ports or the init keys in docker-compose.yml.
#
# Then:  set -a && source infra/langfuse.env && set +a
#
# Fake credentials, local stack only. See the warning in docker-compose.yml.

# The one switch that turns tracing on. Nothing else does.
# Off by default so that `make check` and the browser track are never affected.
LANGFUSE_TRACING=1

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-wayfarer-local-dev-public
LANGFUSE_SECRET_KEY=sk-lf-wayfarer-local-dev-secret

# For Langfuse Cloud, replace the three above with your project's values:
#   LANGFUSE_HOST=https://cloud.langfuse.com        (or https://us.cloud.langfuse.com)
#   LANGFUSE_PUBLIC_KEY=pk-lf-...
#   LANGFUSE_SECRET_KEY=sk-lf-...
